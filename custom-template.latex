\documentclass[
	$if(fontsize)$
	  $fontsize$,
	$endif$
	$for(classoption)$
	  $classoption$$sep$,
	$endfor$
]{article}

\usepackage[margin=1in, a4paper]{geometry}
\usepackage{graphicx}
\usepackage{fontspec}
\usepackage{hyperref}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{framed}
\usepackage{color}

\pagestyle{fancy}

$if(highlighting-macros)$
$highlighting-macros$
$endif$

\hypersetup{
    colorlinks=true,
    linkcolor=black,
    filecolor=black,
}

$if(mainfont)$
\setmainfont[$for(mainfontoptions)$$mainfontoptions$$sep$,$endfor$]{$mainfont$}
$else$
\setmainfont{Cormorant Infant}
$endif$

$if(monofont)$
\setmonofont[$for(monofontoptions)$$monofontoptions$$sep$,$endfor$]{$monofont$}
$else$
\setmonofont{JetBrainsMono Nerd Font}
$endif$

\title{$title$}
\author{$author$}
\date{$date$}

\begin{document}

\fancyhf{}
$if(header)$
\fancyhead[R]{$header$}
$endif$

$if(footer)$
\fancyfoot[R]{$footer$}
$endif$


\maketitle

$body$

\end{document}

